#!/bin/bash
# Chromium is not autostarted and is not a supervisord program, so there is
# nothing to `supervisorctl restart`. This starts or restarts it.
set -euo pipefail
pkill -f 'remote-debugging-port' || true
sleep 1
DISPLAY=:1 nohup /usr/local/bin/start-chromium.sh >/tmp/chromium.log 2>&1 &
echo "Chromium restarting; CDP on 127.0.0.1:${CDP_PORT:-9222}"
