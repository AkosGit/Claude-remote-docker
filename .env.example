# Copy to .env and fill in.  cp .env.example .env

# --- Push notifications (ntfy) -----------------------------------------------
# The topic your phone subscribes to in the ntfy app.
#
# On the public ntfy.sh, topics are unauthenticated: anyone who guesses the
# name can read your notifications and publish to them. Use something long and
# random, e.g. `openssl rand -hex 16`.
NTFY_TOPIC=claude-CHANGE-ME-to-something-random

# Public server, or your own instance (https://ntfy.example.com).
NTFY_SERVER=https://ntfy.sh

# Only needed for a self-hosted server with auth enabled.
NTFY_TOKEN=

# --- Web desktop (KasmVNC) ---------------------------------------------------
# Web UI credentials (KasmVNC, HTTP basic auth).
#
#   VNC_USER      any length; a real username, unlike classic VNC.
#   VNC_PASSWORD  min 1 character, max ~180 characters.
#
# Measured, not quoted from docs:
#   - 1 character works. The kasmvncpasswd tool refuses anything under 6, but
#     that is input validation in the CLI only -- the entrypoint writes the
#     password file directly when needed, so short passwords do work.
#   - Verified working at 180 characters. At 190+ the server starts rejecting
#     with 401/403 inconsistently, which is an internal buffer limit rather
#     than a defined rule. Nothing near a realistic password.
#   - No truncation anywhere in that range: the hash is SHA-256 crypt, so the
#     whole password counts.
#
# Leave VNC_PASSWORD blank to have one generated and printed to the logs.
VNC_USER=claude
VNC_PASSWORD=

# --- Session user -------------------------------------------------------------
# Who the desktop session runs as: KasmVNC, XFCE, and therefore Chromium and
# Claude Desktop.
#
# root  - Claude can do privileged work directly. HOME is still /home/claude,
#         so logins and profiles persist in the volume as normal.
# claude - unprivileged. It still has passwordless sudo, so Claude can run
#         privileged commands without the session itself being root.
#
# Do not launch individual apps under sudo while the session runs as claude:
# that leaves root-owned files in /home/claude and breaks the next non-root
# start with an error that looks unrelated. Switch this instead.
SESSION_USER=root

# --- TLS: one variable per server ---------------------------------------------
# Two switches, because the two servers pull in opposite directions.
#
# KASMVNC_TLS (web UI on NOVNC_PORT) -- keep this at 1.
#   Browsers expose navigator.clipboard only in a secure context: HTTPS
#   anywhere, or plain HTTP on localhost and nowhere else. Setting this to 0
#   and then browsing by IP silently disables copy/paste, with no error shown.
#
# X11VNC_TLS (native VNC on X11VNC_PORT) -- 0 unless you need it.
#   1 wraps RFB in TLS. Only clients that speak VNC-over-SSL can then connect
#   (bVNC Secure, SSVNC); macOS Screen Sharing and ordinary VNC clients hang,
#   because the server is waiting for a ClientHello that never arrives.
#   0 is reasonable when the traffic already rides an encrypted overlay such as
#   ZeroTier or Tailscale, or an SSH tunnel. Not on a plain LAN.
#
# Both share one certificate, so VNC_TLS_SAN covers whichever are enabled.
KASMVNC_TLS=1
X11VNC_TLS=0

# Legacy single switch. Still honoured as the fallback for both of the above
# when they are unset, so older .env files keep working. Prefer the two above.
#VNC_TLS=1

# The address you actually type in the browser -- server IP, hostname, or
# Tailscale name. Comma-separated for several.
#
# Chrome ignores a certificate's Common Name and matches only subjectAltName,
# so if you browse by an address that is not listed here, it will reject the
# certificate outright rather than offering a click-through warning. After
# changing this, delete the .vnc-tls directory in the home volume to reissue:
#   docker compose exec claude-desktop rm -rf /home/claude/.vnc-tls
VNC_TLS_SAN=

# Host interface the port publishes on. 127.0.0.1 keeps it local; use
# 0.0.0.0 for a remote deployment, and only with VNC_TLS=1.
BIND_ADDR=127.0.0.1

VNC_RESOLUTION=1600x900
VNC_DEPTH=24

# Max updates per second sent to the browser. Lower it if the connection is
# slow, raise it for smoother video.
VNC_FRAMERATE=30

# --- Native VNC (x11vnc) ------------------------------------------------------
# Native VNC password (x11vnc, classic RFB auth).
#
#   X11VNC_PASSWORD  min 1 character, HARD MAX 8 characters.
#   username         does not exist -- the protocol has no username field.
#
# The 8-character ceiling is the protocol itself: RFB VncAuth is DES with an
# 8-byte key. Everything past character 8 is SILENTLY DISCARDED -- storing
# "abcdefghWXYZ" and storing "abcdefgh" produce byte-identical password files.
# So a 20-character password here gives you exactly 8 characters of security
# and no warning. This is why the port stays bound to loopback.
#
# Leave empty to reuse the first 8 characters of VNC_PASSWORD. Set it
# separately when VNC_PASSWORD is longer than 8 and you want a deliberate
# native-client password rather than a silent prefix of it.
X11VNC_PORT=5901


X11VNC_PASSWORD=

# --- Ports (inside the container; change the host side in docker-compose.yml) -
NOVNC_PORT=6080
CDP_PORT=9222

# --- Claude Desktop ----------------------------------------------------------
# Leave UNSET unless you accept the trade-off. Unset, the app's own os_crypt
# autodetection decides how to persist your session, and it refuses weak
# on-disk storage rather than writing tokens unsafely -- which in a container
# with no keyring means logging in again after each restart.
#
# Setting this to `basic` keeps you logged in across restarts by storing the
# session token on disk in the home volume with weak protection. Anyone who
# can read the volume can read the token.
# CLAUDE_PASSWORD_STORE=basic

# Set to 1 to force-disable GPU acceleration. Already the default in this
# image, since there is no GPU in the container.
CLAUDE_DISABLE_GPU=1

# --- Browser -----------------------------------------------------------------
# Page Chromium opens on launch.
CHROMIUM_START_URL=https://claude.ai
