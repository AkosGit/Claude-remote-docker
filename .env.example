# Copy to .env and fill in.  cp .env.example .env

# --- Push notifications (ntfy) -----------------------------------------------
# The topic your phone subscribes to in the ntfy app.
#
# On the public ntfy.sh, topics are unauthenticated: anyone who guesses the
# name can read your notifications and publish to them. Use something long and
# random, e.g. `openssl rand -hex 16`.
NTFY_TOPIC=claude-CHANGE-ME-to-something-random

# Public server, or your own instance (https://ntfy.example.com).
NTFY_SERVER=https://ntfy.sh

# Only needed for a self-hosted server with auth enabled.
NTFY_TOKEN=

# --- Web desktop (KasmVNC) ---------------------------------------------------
# Username and password for the web UI. Unlike classic VNC auth, this is real
# basic auth: no 8-character ceiling, so use a proper password.
# Leave VNC_PASSWORD blank to have one generated and printed to the logs.
VNC_USER=claude
VNC_PASSWORD=

VNC_RESOLUTION=1920x1080
VNC_DEPTH=24

# Max updates per second sent to the browser. Lower it if the connection is
# slow, raise it for smoother video.
VNC_FRAMERATE=30

# --- Ports (inside the container; change the host side in docker-compose.yml) -
NOVNC_PORT=6080
CDP_PORT=9222

# --- Claude Desktop ----------------------------------------------------------
# Leave UNSET unless you accept the trade-off. Unset, the app's own os_crypt
# autodetection decides how to persist your session, and it refuses weak
# on-disk storage rather than writing tokens unsafely -- which in a container
# with no keyring means logging in again after each restart.
#
# Setting this to `basic` keeps you logged in across restarts by storing the
# session token on disk in the home volume with weak protection. Anyone who
# can read the volume can read the token.
# CLAUDE_PASSWORD_STORE=basic

# Set to 1 to force-disable GPU acceleration. Already the default in this
# image, since there is no GPU in the container.
CLAUDE_DISABLE_GPU=1

# --- Browser -----------------------------------------------------------------
# Page Chromium opens on launch.
CHROMIUM_START_URL=https://claude.ai
